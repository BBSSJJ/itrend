#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

required_files=(
  ".agents/skills/issue-triage/SKILL.md"
  "AGENTS.md"
  "README.md"
  "collector/.env.example"
  "config/canonical-tags.json"
  "docs/PRODUCT.md"
  "docs/ARCHITECTURE.md"
  "docs/QUALITY.md"
  "docs/WORKFLOW.md"
  "docs/plans/README.md"
  "docs/plans/tech-debt.md"
)

echo "[check] Harness 파일 확인"
for relative_path in "${required_files[@]}"; do
  if [[ ! -f "$repo_root/$relative_path" ]]; then
    echo "필수 파일이 없습니다: $relative_path" >&2
    exit 1
  fi
done

echo "[check] Agent skill 형식 검사"
node -e '
const fs = require("node:fs")
const content = fs.readFileSync(process.argv[1], "utf8")
const match = content.match(/^---\r?\n([\s\S]*?)\r?\n---(?:\r?\n|$)/)
if (!match) {
  throw new Error("SKILL.md YAML frontmatter가 없거나 형식이 잘못됐습니다")
}

const fields = new Map()
for (const line of match[1].split(/\r?\n/)) {
  const field = line.match(/^([a-z][a-z0-9-]*):\s*(.+)$/)
  if (!field) {
    throw new Error(`SKILL.md frontmatter 필드 형식이 잘못됐습니다: ${line}`)
  }
  if (fields.has(field[1])) {
    throw new Error(`SKILL.md frontmatter 필드가 중복됩니다: ${field[1]}`)
  }
  fields.set(field[1], field[2].trim())
}

const keys = [...fields.keys()].sort()
if (keys.join(",") !== "description,name") {
  throw new Error(`SKILL.md frontmatter는 name과 description만 포함해야 합니다: ${keys.join(", ")}`)
}
const name = fields.get("name")
const description = fields.get("description")
if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(name) || name.length > 64) {
  throw new Error(`SKILL.md name이 잘못됐습니다: ${name}`)
}
if (!description || description.length > 1024 || /[<>]/.test(description)) {
  throw new Error("SKILL.md description이 잘못됐습니다")
}
if (/^\s*\[TODO:/m.test(content)) {
  throw new Error("SKILL.md에 미완성 TODO가 남아 있습니다")
}
' "$repo_root/.agents/skills/issue-triage/SKILL.md"

echo "[check] 셸 스크립트 구문 검사"
bash -n "$repo_root/scripts/setup" "$repo_root/scripts/check"

echo "[check] Canonical 태그 검사"
node -e '
const fs = require("node:fs")
const tags = JSON.parse(fs.readFileSync(process.argv[1], "utf8"))
const format = /^[a-z0-9]+(?:[.+#-][a-z0-9]+)*$/
if (!Array.isArray(tags) || tags.some(tag => typeof tag !== "string")) {
  throw new Error("canonical 태그는 문자열 배열이어야 합니다")
}
if (new Set(tags).size !== tags.length) {
  throw new Error("canonical 태그에 중복이 있습니다")
}
const invalid = tags.filter(tag => !format.test(tag))
if (invalid.length > 0) {
  throw new Error(`canonical 태그 형식이 잘못됐습니다: ${invalid.join(", ")}`)
}
' "$repo_root/config/canonical-tags.json"

echo "[check] Collector JavaScript 구문 검사"
while IFS= read -r -d '' source_file; do
  node --check "$source_file"
done < <(find "$repo_root/collector" -path '*/node_modules' -prune -o -name '*.js' -type f -print0)

echo "[check] Collector 테스트"
npm --prefix "$repo_root/collector" test

echo "[check] PostgreSQL 준비"
docker compose --project-directory "$repo_root" up -d --wait postgres
docker compose --project-directory "$repo_root" exec -T postgres \
  psql --set ON_ERROR_STOP=1 -U itrend -d itrend \
  -f /docker-entrypoint-initdb.d/01_schema.sql >/dev/null

echo "[check] Server 테스트"
(
  cd "$repo_root/server"
  ./gradlew test
)

echo "[check] Frontend 린트"
npm --prefix "$repo_root/frontend" run lint

echo "[check] Frontend 프로덕션 빌드"
npm --prefix "$repo_root/frontend" run build

echo "[check] 전체 검증 통과"
