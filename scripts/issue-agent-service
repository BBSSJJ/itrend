#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
service_label="com.itrend.issue-agent-monitor"
user_id="$(id -u)"
launch_domain="gui/$user_id"
launch_agents_dir="${HOME}/Library/LaunchAgents"
plist_file="$launch_agents_dir/$service_label.plist"
service_log_dir="${HOME}/Library/Logs/ITrend"
poll_interval="${ITREND_AGENT_POLL_INTERVAL:-60}"

usage() {
  cat <<'EOF'
Usage:
  ./scripts/issue-agent-service install [seconds]
  ./scripts/issue-agent-service start
  ./scripts/issue-agent-service stop
  ./scripts/issue-agent-service status
  ./scripts/issue-agent-service uninstall

Manage the per-user macOS launchd service for the local Issue agent monitor.
Installation is stopped by default. Use start and stop to toggle monitoring.
EOF
}

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "issue-agent-service supports macOS launchd only." >&2
  exit 1
fi

action="${1:-}"

require_installation() {
  if [[ ! -f "$plist_file" ]]; then
    echo "Service is not installed. Run: ./scripts/issue-agent-service install" >&2
    exit 1
  fi
}

service_is_loaded() {
  launchctl print "$launch_domain/$service_label" >/dev/null 2>&1
}

service_is_disabled() {
  launchctl print-disabled "$launch_domain" 2>/dev/null |
    grep -Fq '"'"$service_label"'" => true'
}

case "$action" in
  install)
    if [[ $# -ge 2 ]]; then
      poll_interval="$2"
    fi
    [[ $# -le 2 ]] || { usage >&2; exit 2; }
    if [[ ! "$poll_interval" =~ ^[1-9][0-9]*$ ]]; then
      echo "Polling interval must be a positive integer: $poll_interval" >&2
      exit 2
    fi

    mkdir -p "$launch_agents_dir" "$service_log_dir"
    launchctl bootout "$launch_domain/$service_label" >/dev/null 2>&1 || true
    launchctl disable "$launch_domain/$service_label"

    plutil -create xml1 "$plist_file"
    plutil -insert Label -string "$service_label" "$plist_file"
    plutil -insert ProgramArguments -xml '<array/>' "$plist_file"
    plutil -insert ProgramArguments.0 -string \
      "$repo_root/scripts/issue-agent-monitor" "$plist_file"
    plutil -insert ProgramArguments.1 -string "--watch" "$plist_file"
    plutil -insert ProgramArguments.2 -string "$poll_interval" "$plist_file"
    plutil -insert WorkingDirectory -string "$repo_root" "$plist_file"
    plutil -insert EnvironmentVariables -xml '<dict/>' "$plist_file"
    plutil -insert EnvironmentVariables.PATH -string "$PATH" "$plist_file"
    plutil -insert RunAtLoad -bool true "$plist_file"
    plutil -insert KeepAlive -bool true "$plist_file"
    plutil -insert ProcessType -string Background "$plist_file"
    plutil -insert ThrottleInterval -integer 10 "$plist_file"
    plutil -insert StandardOutPath -string \
      "$service_log_dir/issue-agent-monitor.log" "$plist_file"
    plutil -insert StandardErrorPath -string \
      "$service_log_dir/issue-agent-monitor.error.log" "$plist_file"
    plutil -lint "$plist_file"

    echo "Installed $service_label in the OFF state (polling interval: $poll_interval seconds)."
    echo "Turn it on with: ./scripts/issue-agent-service start"
    ;;
  start)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    require_installation
    launchctl enable "$launch_domain/$service_label"
    if ! service_is_loaded; then
      launchctl bootstrap "$launch_domain" "$plist_file"
    fi
    launchctl kickstart -k "$launch_domain/$service_label"
    echo "Started $service_label (ON)."
    ;;
  stop)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    require_installation
    launchctl disable "$launch_domain/$service_label"
    launchctl bootout "$launch_domain/$service_label" >/dev/null 2>&1 || true
    echo "Stopped $service_label (OFF)."
    ;;
  status)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    if [[ ! -f "$plist_file" ]]; then
      echo "$service_label is not installed (OFF)."
    elif service_is_disabled; then
      echo "$service_label is installed and disabled (OFF)."
    elif service_is_loaded; then
      echo "$service_label is running (ON)."
      launchctl print "$launch_domain/$service_label" |
        grep -E '^\s*(state|pid) = ' || true
    else
      echo "$service_label is installed but not running (OFF)."
    fi
    ;;
  uninstall)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    launchctl bootout "$launch_domain/$service_label" >/dev/null 2>&1 || true
    launchctl enable "$launch_domain/$service_label" >/dev/null 2>&1 || true
    rm -f "$plist_file"
    echo "Uninstalled $service_label. Local agent worktrees and logs were preserved."
    ;;
  -h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
