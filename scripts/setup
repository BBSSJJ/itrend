#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

for command_name in node npm java docker; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "필수 명령을 찾을 수 없습니다: $command_name" >&2
    exit 1
  fi
done

echo "[setup] Collector 의존성 설치"
npm --prefix "$repo_root/collector" ci

echo "[setup] Frontend 의존성 설치"
npm --prefix "$repo_root/frontend" ci

echo "[setup] PostgreSQL 시작"
docker compose --project-directory "$repo_root" up -d --wait postgres
docker compose --project-directory "$repo_root" exec -T postgres \
  psql --set ON_ERROR_STOP=1 -U itrend -d itrend \
  -f /docker-entrypoint-initdb.d/01_schema.sql >/dev/null

echo "[setup] Server 빌드 준비"
(
  cd "$repo_root/server"
  ./gradlew classes
)

echo "[setup] 완료"
echo "collector/.env가 없다면 collector/.env.example을 복사하고 값을 설정하세요."
